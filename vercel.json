{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sitebot.tech"
        }
      ],
      "destination": "https://phoneshoppos.com/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.sitebot.tech"
        }
      ],
      "destination": "https://phoneshoppos.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sitebot.tech"
        }
      ],
      "destination": "https://phoneshoppos.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sitebot.tech"
        }
      ],
      "destination": "https://phoneshoppos.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/print/:path*",
      "destination": "https://app.phoneshoppos.com/print/:path*?via=site"
    }
  ]
}
